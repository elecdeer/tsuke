{
  "compilerOptions": {
    "target": "ES2022",
    // Temporal の型だけ足す。ない環境では使う側で temporal-polyfill-lite を読み込む
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "ESNext.Temporal"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", ".storybook/*.ts", "*.ts"]
}
